@startuml
'https://plantuml.com/sequence-diagram

autonumber

@startuml
Main -> Game : startSession()
Game -> TextUI : displayMessage()
Game -> FileIO : readData()
alt Data found
    Game -> Game : createPlayer()
else Data not found
    loop for antal spillere
        Game -> TextUI : displayMessage()
        Game -> Game : createPlayer()
        Game -> Game : registerPlayer()
    end
end
Main -> Game : displayPlayers()

